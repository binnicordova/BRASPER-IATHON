# Nombres de variables de las 4 piezas. NO pongas valores reales aquí:
# copia el .env.example de cada carpeta a su archivo de entorno (git-ignored).
# Todas las piezas apuntan al proyecto Firebase "aibrasper" (la config web de
# Firebase es pública; el acceso lo controlan las reglas y las Cloud Functions).

# --- app/ (.env.local) — opcionales, la app corre sin ninguna ---
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_WHATSAPP_NUMBER=
EAS_OWNER=
EAS_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost

# --- app/functions: secreto de Firebase, nunca en un archivo del repo ---
# firebase functions:secrets:set GEMINI_API_KEY --project aibrasper

# --- web/ (.env) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_FIREBASE_API_KEY= / VITE_FIREBASE_PROJECT_ID= / VITE_FIREBASE_STORAGE_BUCKET=

# --- backoffice/ (.env) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- whatsapp-agent/kapso: secretos en Kapso, no en archivos ---
# TASAS_CAIDAS=1   (solo para simular fallos en la demo)
